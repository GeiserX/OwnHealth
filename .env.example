# Copy to .env and fill in. Every OWNHEALTH_* variable also accepts a *_FILE twin
# (for example OWNHEALTH_SECRET_KEY_FILE=/run/secrets/secret_key), which wins.

# Password of the owner role `ownhealth`: Postgres and the one-shot admin service (migrations,
# backups, restores). Generate one: openssl rand -base64 32
OWNHEALTH_DB_PASSWORD=
# Password of the app's own database role `ownhealth_app` (no table owner). Generate one: openssl rand -base64 32
OWNHEALTH_APP_DB_PASSWORD=
# Signs sessions and pagination cursors. Generate one: openssl rand -base64 48
OWNHEALTH_SECRET_KEY=
# The URL people open, used for passkeys and links (no trailing slash). If this URL also supplies
# the wearables callback origin, use a lowercase host and omit the default port.
OWNHEALTH_BASE_URL=http://localhost:8080
# Host port the app listens on (bound to 127.0.0.1; put a reverse proxy in front).
OWNHEALTH_HTTP_PORT=8080
# es or en.
OWNHEALTH_DEFAULT_LOCALE=es
# The household's time zone, an IANA name. It reads the wall-clock times of a LibreView or Dexcom
# Clarity CSV export, and the day MCP budgets reset on. Unset, a CGM export is read in the zone of
# the uploader's browser, and MCP days are UTC days. A name the time zone database does not know is
# no zone.
# OWNHEALTH_TIMEZONE=Europe/Madrid

# Auto-accept threshold for imported rows (never below 0.90).
# OWNHEALTH_AUTO_ACCEPT_THRESHOLD=0.95
# Age of majority for the minor rule. A household's own setting (PUT /api/household/settings)
# overrides it; GET /api/household shows the value in force. Ages count on the UTC day, the day
# records are stored on, whatever TZ or OWNHEALTH_TIMEZONE say.
# OWNHEALTH_AGE_OF_MAJORITY=18
# Background job workers in the app process.
# OWNHEALTH_JOB_WORKERS=2
# Past this many wearable samples, `ownhealth partition` (run as the owner, in the admin service)
# turns the samples table into monthly partitions with no row copied. deploy/README.md, "Large
# wearable histories".
# OWNHEALTH_PARTITION_ROWS=50000000

# Demo: seed the synthetic Rivera family once at startup. Never on a real install.
# OWNHEALTH_DEMO=1
# Dev only: unauthenticated requests act as the first owner. Never on a real install.
# OWNHEALTH_DEV_AUTH=1

# The secrets key is not set here: compose.yaml reads it from the file secrets/secrets_key (32 random
# bytes, base64: openssl rand -base64 32). It seals every profile's files and the inboxes' secrets,
# and OwnHealth refuses to start without it. Keep a copy with your backups: they cannot be read without it.
# OCR for scans and photos (only the `ocr` image variant carries the models). Off: scans wait as
# pending documents for an agent or a person. Turn on both lines together: the first starts the `ocr`
# worker (compose.yaml), the second sends unread pages to it.
# COMPOSE_PROFILES=ocr
# OWNHEALTH_OCR=1
# OWNHEALTH_OCR_MODELS_DIR=/opt/ownhealth/ocr-models
# Watched folder: files dropped here (one subfolder per profile) are imported.
# OWNHEALTH_INBOX_DIR=/inbox

# Imaging (v1.0): Orthanc for hospital CDs, with the OHIF viewer. Add imaging to the COMPOSE_PROFILES
# line above and follow the comment above the orthanc service in compose.yaml. Point the URL only at
# the Orthanc of that service: OwnHealth deletes every study in it that its record does not name, at
# every start and every hour, so an Orthanc that holds other studies loses them.
# OWNHEALTH_ORTHANC_URL=http://orthanc:8042

# Wearables (v1.0): the Open Wearables sidecar, for Oura, Whoop, Polar and Withings. Add wearables to
# the COMPOSE_PROFILES line above (COMPOSE_PROFILES=ocr,wearables with OCR on, otherwise
# COMPOSE_PROFILES=wearables). Its three secrets go in openwearables.env next to this file, never
# here, because every OwnHealth container reads this file. One line each, from openssl rand -hex 32:
# OPENWEARABLES_DB_PASSWORD, OPENWEARABLES_SECRET_KEY and OPENWEARABLES_ADMIN_PASSWORD.
# Optional callback origin for the wearables profile. Defaults to OWNHEALTH_BASE_URL or the
# published localhost address. Use a lowercase host and omit the default port and trailing slash.
# OWNHEALTH_OW_PUBLIC_URL=https://share.example.org
