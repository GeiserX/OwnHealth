  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Check a drug against the record"
    },
    "description": "Everything the record says about one drug for one profile, in one call: pharmacogenomic guidance (CPIC, DPWG) for the profile's genotypes, current medications that change a gene's function (phenoconversion), current medications that matter for the drug, and the labs a prescriber would look at. Guidance is quoted with its source; it is followed by 'Discuss with your prescriber.' Parts this token cannot read are named in withheld.by_scope. Drug-drug interactions beyond phenoconversion are not assessed.",
    "inputSchema": {
      "properties": {
        "profile": {
          "type": "string"
        },
        "drug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Generic or brand name in es/en, or a CPIC drug id"
        },
        "as_of": {
          "type": "string"
        },
        "cursor": {
          "type": "string",
          "description": "next_cursor of the previous answer: more relevant_labs"
        }
      },
      "required": [
        "drug"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "name": "check_drug",
    "outputSchema": {
      "properties": {
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "lang": {
          "enum": [
            "es",
            "en"
          ]
        },
        "identity_mode": {
          "enum": [
            "full",
