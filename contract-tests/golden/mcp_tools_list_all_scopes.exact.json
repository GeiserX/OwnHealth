  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Look up one genome position"
    },
    "description": "What the profile's genome says at one position (rsID, HGVS or a region up to 1 Mb), read from the tabix-indexed VCF. call_state is always one of ref, alt, no_call, not_on_array, not_covered; not_on_array and not_covered mean unknown, not negative. Positions inside a gene behind the profile's sensitive opt-in come back withheld. Capped per token per day; quota shows what is left.",
    "inputSchema": {
      "properties": {
        "profile": {
          "type": "string"
        },
        "rsid": {
          "type": "string",
          "pattern": "^rs\\d+$"
        },
        "hgvs": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_.:>+*()\\-]+$"
        },
        "region": {
          "type": "string",
          "pattern": "^chr[0-9XYM]+:\\d+-\\d+$"
        },
        "cursor": {
          "type": "string"
        }
      },
      "type": "object",
      "oneOf": [
        {
          "required": [
            "rsid"
          ]
        },
        {
          "required": [
            "hgvs"
          ]
