  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Genome findings"
    },
    "description": "Curated findings from the profile's OwnGenome genome-facts file: pharmacogenes, pathogenic variants, carrier status, HLA, risk markers, each with evidence E1-E4, confidence and call_state (ref, alt, no_call, not_on_array, not_covered). Filter by category or gene. E4 and traits are left out unless asked for. not_assessed lists what the source could not test: not assessed is unknown, not negative. withheld.sensitive counts findings behind the profile's opt-in; their content is never shown. Research-grade unless a clinical lab confirmed it.",
    "inputSchema": {
      "properties": {
        "profile": {
          "type": "string"
        },
        "category": {
          "enum": [
            "pgx",
            "monogenic_pathogenic",
            "acmg_sf",
            "carrier",
            "hla",
            "trait",
            "risk_marker",
            "prs",
            "ancestry"
          ]
        },
        "gene": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,20}$"
        },
        "min_evidence": {
          "enum": [
            "E1",
            "E2",
            "E3",
            "E4"
          ],
          "default": "E2"
        },
        "detail": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        },
        "cursor": {
          "type": "string"
        },
        "as_of": {
          "type": "string"
        }
      },
      "type": "object",
      "additionalProperties": false
    },
