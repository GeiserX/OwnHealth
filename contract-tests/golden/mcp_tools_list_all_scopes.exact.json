  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Trend of one analyte or metric"
    },
    "description": "One lab analyte (LOINC code or name) or wearable metric (e.g. 'hr_resting') over a window such as P3Y, downsampled to fit, with coverage and change statistics and medication start/stop annotations. Points keep the printed value and unit beside the canonical one; every point has a src id. Analytes that arrived under two LOINC codes are both kept and named in codes. Missing is not normal.",
    "inputSchema": {
      "properties": {
        "profile": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "LOINC code, metric id (e.g. 'hr_resting') or name"
        },
        "window": {
          "type": "string",
          "pattern": "^(P\\d+[DMY]|all)$",
          "default": "P3Y"
        },
        "resolution": {
          "enum": [
            "auto",
            "raw",
            "day",
            "week",
            "month"
          ],
          "default": "auto"
