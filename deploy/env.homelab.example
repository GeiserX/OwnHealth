# Copy to .env next to compose.yaml. Secrets do not go here: they live in secrets/ as files.

# The name people open, without https://. Caddy gets its certificate for it. (Not OWNHEALTH_HOST:
# the app reads that one as the address it listens on inside the container, 0.0.0.0.)
OWNHEALTH_DOMAIN=health.example.lan
# es or en.
OWNHEALTH_DEFAULT_LOCALE=es
# The household's time zone, an IANA name. It reads the wall-clock times of a LibreView or Dexcom
# Clarity CSV export, and the day MCP budgets reset on. Unset, a CGM export is read in the zone of
# the uploader's browser, and MCP days are UTC days. A name the time zone database does not know is
# no zone.
# OWNHEALTH_TIMEZONE=Europe/Madrid

# The restic repository and its keys go in restic.env (restic.env.example), which only the admin
# service reads. An install that still has them here keeps working, but the app then sees them too.

# OCR for scans and photos (v0.2). Turn on both lines together: the first starts the `ocr` worker,
# the second makes the app send pages without a text layer to it. Off, scans wait as pending
# documents for your own agent (docs/agent-extraction.md) or for you.
# COMPOSE_PROFILES=ocr
# OWNHEALTH_OCR=1

# Sharing a summary through a SMART Health Link (deploy/README.md, Sharing a summary). Off while
# unset. Set it to the public https address of a tunnel that points at 127.0.0.1:8090 on this host;
# every link carries it. The app refuses to start with an http address other than localhost.
# OWNHEALTH_SHARE_URL=https://share.example.org
# The host port of that listener, if 8090 is taken. It is published on 127.0.0.1 only.
# OWNHEALTH_SHARE_PORT=8090

# Wearables (v1.0): the Open Wearables sidecar, for Oura, Whoop, Polar and Withings. Add wearables to
# the COMPOSE_PROFILES line above (COMPOSE_PROFILES=ocr,wearables with OCR on, otherwise
# COMPOSE_PROFILES=wearables). Its three secrets go in openwearables.env next to this file, never
# here, because every OwnHealth container reads this file: OPENWEARABLES_DB_PASSWORD,
# OPENWEARABLES_SECRET_KEY and OPENWEARABLES_ADMIN_PASSWORD. Steps: deploy/README.md, "Wearables".
