# Copy to .env next to compose.yaml. Secrets do not go here: they live in secrets/ as files.

# The name people open, without https://. Caddy gets its certificate for it. (Not OWNHEALTH_HOST:
# the app reads that one as the address it listens on inside the container, 0.0.0.0.)
OWNHEALTH_DOMAIN=health.example.lan
# es or en.
OWNHEALTH_DEFAULT_LOCALE=es

# The restic repository and its keys go in restic.env (restic.env.example), which only the admin
# service reads. An install that still has them here keeps working, but the app then sees them too.
