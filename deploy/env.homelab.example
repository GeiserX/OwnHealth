# Copy to .env next to compose.yaml. Secrets do not go here: they live in secrets/ as files.

# The name people open, without https://. Caddy gets its certificate for it.
OWNHEALTH_HOST=health.example.lan
# es or en.
OWNHEALTH_DEFAULT_LOCALE=es

# Where restic keeps the backups: a local path, sftp:, s3:, rest:, b2: ... (restic docs).
RESTIC_REPOSITORY=s3:https://s3.example.lan/ownhealth-backup
# S3 keys, only for an s3: repository.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
