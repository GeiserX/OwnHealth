# Copy to restic.env next to compose.yaml. Only the admin service reads this file, so the app never
# sees the keys to the backups.

# Where restic keeps the backups: sftp:, s3:, rest:, b2: ... (restic docs). A local path works only
# when you mount it into the admin service: the admin container is read-only outside /data and /tmp,
# and /data is the volume the backup protects.
RESTIC_REPOSITORY=s3:https://s3.example.lan/ownhealth-backup
# S3 keys, only for an s3: repository.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
