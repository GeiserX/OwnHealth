# The share listener below sits behind a tunnel on the same host, which reaches it through the
# loopback port compose publishes. Caddy keeps the X-Forwarded-For that tunnel sends and adds the hop
# it saw, so the app's access log names the recipient's address (OWNHEALTH_TRUSTED_PROXIES).
{
	servers :8090 {
		trusted_proxies static private_ranges
	}
}

# HTTPS in front of OwnHealth. Caddy gets a certificate for OWNHEALTH_DOMAIN by itself.
# For a name that only exists on your LAN, replace the automatic certificate with `tls internal`
# (Caddy's own CA; trust its root on your devices) or a DNS challenge plugin.
{$OWNHEALTH_DOMAIN} {
	# Health data stays on your network: only the LAN and a Tailscale tailnet may connect.
	# Remove these two lines only if you know you want OwnHealth on the public internet.
	# This trusts the client address Caddy sees. Rootless Docker and Docker's IPv6 userland proxy replace
	# it with a private one; there, close 80 and 443 at the firewall too (deploy/README.md, Who can connect).
	@outside not remote_ip private_ranges 100.64.0.0/10
	respond @outside 403

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy app:8080
}

# The public site block for SMART Health Links (docs/design/security-privacy.md section 11). It
# passes the manifest (POST and OPTIONS), file (GET), and direct ICE card file (GET).
# The Open Wearables callback and its result pages are opt-in (GET only).
# Caddy matches the cleaned path, so a raw path such as /login/../api/shl/<id> also matches.
# Each route is rewritten to its canonical path. The direct file and OAuth routes keep their queries.
# compose.homelab.yaml publishes this port on 127.0.0.1 only. Point a tunnel (Tailscale Funnel,
# Cloudflare Tunnel) at it, never at the app or the site above, and set OWNHEALTH_SHARE_URL in .env
# to the public https address the tunnel gives (deploy/README.md, Sharing a summary).
http://:8090 {
	@manifest {
		method POST OPTIONS
		path_regexp m ^/api/shl/([A-Za-z0-9_-]{43})$
	}
	@file {
		method GET
		path_regexp f ^/api/shl/([A-Za-z0-9_-]{43})/file/([A-Za-z0-9_-]{43})$
	}
	@ice {
		method GET
		path_regexp i ^/api/shl/([A-Za-z0-9_-]{43})/ice$
	}
	@ow_callback {
		method GET
		path_regexp ow ^/ow/api/v1/oauth/((?:oura|polar|whoop|withings)/callback|success|error)$
		expression "{$OWNHEALTH_OW_CALLBACK:false}" == "true"
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	handle @manifest {
		rewrite * /api/shl/{re.m.1}?
		reverse_proxy app:8080
	}
	handle @file {
		rewrite * /api/shl/{re.f.1}/file/{re.f.2}?
		reverse_proxy app:8080
	}
	handle @ice {
		rewrite * /api/shl/{re.i.1}/ice
		reverse_proxy app:8080
	}
	handle @ow_callback {
		rewrite * /ow/api/v1/oauth/{re.ow.1}
		reverse_proxy app:8080
	}
	handle {
		respond 404
	}
}
